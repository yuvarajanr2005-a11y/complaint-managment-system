{
  "name": "college-complaint-management-system",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "nodemon backend/src/index.js",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:server": "nodemon backend/src/index.js",
    "dev:client": "npm run dev --workspace frontend",
    "build": "npm run build --workspace frontend",
    "start": "node backend/src/index.js",
    "test": "node --test backend/test/api.test.js",
    "seed:admin": "node backend/src/utils/seedAdmin.js",
    "seed:demo": "node backend/src/utils/seedDemo.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.9"
  }
}
